{
  "name": "dsh-file-download",
  "version": "0.4.2",
  "private": true,
  "description": "File browser, download surface, and mode-gated upload for the DSH Web GUI: browse the whole serving filesystem, download files, archive folders and selections as streamed ZIPs, and upload with an overwrite prompt under a read-only / workspace-write / full-access policy that defaults to the session's own.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node tests/validate.mjs && node --test tests/*.test.mjs && node tests/contract.mjs",
    "validate": "node tests/validate.mjs",
    "unit": "node --test tests/*.test.mjs",
    "contract": "node tests/contract.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "web-ui",
    "download",
    "file-download",
    "workspace",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaguraSayuki/dsh-file-download.git"
  },
  "homepage": "https://github.com/KaguraSayuki/dsh-file-download#readme",
  "bugs": {
    "url": "https://github.com/KaguraSayuki/dsh-file-download/issues"
  }
}
